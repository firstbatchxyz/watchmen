    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.249",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.249"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.5.4"
  }
}
